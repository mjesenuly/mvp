# Copy to .env, replace ALL private placeholders, then run docker compose up --build.
# Generate a URL-safe password: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
POSTGRES_DB=repairlens
POSTGRES_USER=repairlens
POSTGRES_PASSWORD=REPLACE_WITH_PRIVATE_URL_SAFE_RANDOM_PASSWORD
ADMIN_EMAIL=YOUR_ADMIN_EMAIL
ADMIN_PASSWORD=REPLACE_WITH_PRIVATE_ADMIN_PASSWORD_AT_LEAST_10_CHARACTERS
PORT=3000
APP_ORIGIN=http://localhost:3000
# Local HTTP only; hosted HTTPS must use production.
NODE_ENV=development
