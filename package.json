{
  "name": "repairlens",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "start": "node --import tsx backend/server.ts",
    "test:api": "node --import tsx --test backend/server.test.ts",
    "check:contract": "node scripts/check-contract.mjs"
  },
  "dependencies": {
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "jsdom": "^26.1.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vite": "^6.3.0",
    "vitest": "^3.2.4"
  }
}
