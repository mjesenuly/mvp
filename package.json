{
  "name": "repairlens",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "start": "node --import tsx backend/server.ts",
    "test:api": "node --import tsx --test backend/server.test.ts",
    "check:contract": "node scripts/check-contract.mjs",
    "test:storage": "node --import tsx --test backend/sqlite.test.ts",
    "migrate": "node --import tsx backend/migrate.ts",
    "test:parity": "node scripts/test-api-sqlite.mjs",
    "test:runtime": "node --import tsx --test backend/runtime.test.ts",
    "test:postgres": "node scripts/test-postgres.mjs",
    "migrate:data": "node --import tsx scripts/migrate-sqlite-to-postgres.ts",
    "test:integration": "node scripts/integration.mjs journey",
    "test:integration:restart": "node scripts/integration.mjs restart",
    "test:e2e": "playwright test",
    "test:e2e:list": "playwright test --list"
  },
  "dependencies": {
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "reflect-metadata": "^0.2.2",
    "sql.js": "^1.15.1",
    "tsx": "^4.23.15",
    "typeorm": "^1.1.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/react": "^16.3.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.0",
    "vite": "^6.3.0",
    "vitest": "^3.2.4"
  }
}
