# Copy to .env and replace placeholders before first server start.
STORAGE=sqlite
DATABASE_FILE=.data/repairlens.sqlite
ADMIN_EMAIL=YOUR_ADMIN_EMAIL
ADMIN_PASSWORD=YOUR_ADMIN_PASSWORD_AT_LEAST_10_CHARACTERS
PORT=3000
APP_ORIGIN=http://localhost:3000
# Leave NODE_ENV unset for local HTTP. Production requires HTTPS secure cookies.

# PostgreSQL deployment: set STORAGE=postgres and provide DATABASE_URL privately.
# DATABASE_URL=postgresql://repairlens:CHANGE_ME@localhost:5432/repairlens
# DATABASE_SCHEMA=public
